# Copy this file to .env and fill in your values. Never commit .env.

# Hugging Face access token, needed once to download the Khmer speech-to-text model
# (transcriber/download_model.py). Create one at https://huggingface.co/settings/tokens
HF_TOKEN=

# ---- Docker (docker compose) - optional, defaults shown ----
# Docker uses its own ports so it does not clash with other projects or the non-Docker setup.
# FRONTEND_PORT=3300
# BACKEND_PORT=8300
# DENOISER_PORT=8301
# TRANSCRIBER_PORT=8302
# PUBLIC_API_URL=http://localhost:8300      # URL the browser uses to reach the backend
# CORS_ORIGINS=http://localhost:3300,http://127.0.0.1:3300
# STORAGE_PATH=./backend/storage            # where recordings are kept on your disk
# DENOISE_SAMPLE_RATE=16000                 # 48000 = full-band audio, ~3x slower
